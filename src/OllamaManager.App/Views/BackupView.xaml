<UserControl x:Class="OllamaManager.App.Views.BackupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:OllamaManager.App.Localization"
             xmlns:conv="clr-namespace:OllamaManager.App.Localization">
    <UserControl.Resources>
        <conv:LocConverter x:Key="Loc" />
        <conv:BoolToVisibilityConverter x:Key="BoolVis" />
    </UserControl.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Style="{DynamicResource Text.H1}" Text="{loc:Loc Backup.Title}" />
            <TextBlock Style="{DynamicResource Text.Caption}" Text="{loc:Loc Backup.Subtitle}" Margin="0,4,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Style="{DynamicResource CardStyle}" Margin="0,0,0,16" Padding="20">
            <StackPanel>
                <TextBlock Style="{DynamicResource Text.H3}" Text="{loc:Loc Backup.CreateNew}" Margin="0,0,0,12" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <CheckBox Grid.Row="0" Grid.Column="0" Content="{loc:Loc Backup.IncludeSettings}"
                              IsChecked="{Binding IncludeAppSettings}" Margin="0,0,0,8" />
                    <CheckBox Grid.Row="0" Grid.Column="1" Content="{loc:Loc Backup.IncludeModelfiles}"
                              IsChecked="{Binding IncludeModelfiles}" Margin="0,0,0,8" />
                    <CheckBox Grid.Row="1" Grid.Column="0" Content="{loc:Loc Backup.IncludeBenchmarks}"
                              IsChecked="{Binding IncludeBenchmarkHistory}" />
                    <CheckBox Grid.Row="1" Grid.Column="1" Content="{loc:Loc Backup.IncludeConfigs}"
                              IsChecked="{Binding IncludeCustomConfigs}" />
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                    <Button Content="{loc:Loc Backup.Create}" Command="{Binding CreateBackupCommand}"
                            ToolTip="{loc:Loc Tip.BackupCreate}" Style="{DynamicResource AccentButtonStyle}" Margin="0,0,8,0" />
                    <Button Content="{loc:Loc Common.Refresh}" Command="{Binding RefreshCommand}"
                            ToolTip="{loc:Loc Tip.RefreshButton}" Style="{DynamicResource SecondaryButtonStyle}" Margin="0,0,8,0" />
                    <Button Content="{loc:Loc Backup.OpenFolder}" Command="{Binding OpenFolderCommand}"
                            ToolTip="{loc:Loc Tip.BackupOpenFolder}" Style="{DynamicResource SecondaryButtonStyle}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{DynamicResource CardStyle}" Padding="0">
            <DataGrid ItemsSource="{Binding Backups}" SelectedItem="{Binding SelectedBackup}" BorderThickness="0" Background="Transparent">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="{loc:Loc Backup.Name}" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="📦" FontFamily="Segoe UI Emoji, Segoe UI Symbol, Segoe UI"
                                               FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding FileName}" VerticalAlignment="Center" FontWeight="SemiBold" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="{loc:Loc Backup.CreatedAt}"
                                        Binding="{Binding CreatedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" Width="160" />
                    <DataGridTextColumn Header="{loc:Loc Backup.Size}" Binding="{Binding DisplaySize}" Width="100" />
                    <DataGridTextColumn Header="{loc:Loc Backup.Entries}" Binding="{Binding Entries.Count}" Width="80" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="3" Style="{DynamicResource CardStyle}" Margin="0,16,0,0" Padding="16,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="{loc:Loc Backup.Restore}" Command="{Binding RestoreCommand}"
                        Style="{DynamicResource AccentButtonStyle}" Margin="0,0,8,0" />
                <Button Grid.Column="1" Content="{loc:Loc Backup.Delete}" Command="{Binding DeleteCommand}"
                        Style="{DynamicResource DangerButtonStyle}" />
                <TextBlock Grid.Column="2" Text="{Binding ProgressMessage}" VerticalAlignment="Center"
                           Margin="16,0,0,0" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
            </Grid>
        </Border>
    </Grid>
</UserControl>