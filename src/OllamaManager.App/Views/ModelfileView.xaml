<UserControl x:Class="OllamaManager.App.Views.ModelfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:OllamaManager.App.Localization"
             xmlns:conv="clr-namespace:OllamaManager.App.Localization">
    <UserControl.Resources>
        <conv:LocConverter x:Key="Loc" />
        <conv:BoolToVisibilityConverter x:Key="BoolVis" />
    </UserControl.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Style="{DynamicResource Text.H1}" Text="{loc:Loc Modelfile.Title}" />
            <TextBlock Style="{DynamicResource Text.Caption}" Text="{loc:Loc Modelfile.Subtitle}" Margin="0,4,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Style="{DynamicResource CardSubtleStyle}" Margin="0,0,0,16" Padding="16">
            <StackPanel>
                <TextBlock Text="{loc:Loc ModelfileGuide.Title}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8" />
                <TextBlock Text="{loc:Loc ModelfileGuide.Intro}" TextWrapping="Wrap" FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc ModelfileGuide.Step1Title}" FontWeight="SemiBold" FontSize="12" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc ModelfileGuide.Step1Body}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,8,0" />

                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{loc:Loc ModelfileGuide.Step2Title}" FontWeight="SemiBold" FontSize="12" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{loc:Loc ModelfileGuide.Step2Body}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                </Grid>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{DynamicResource CardStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{DynamicResource SurfaceAltBrush}" Padding="14,10" CornerRadius="10,10,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{loc:Loc Modelfile.Editor}" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="{loc:Loc Modelfile.Open}" Command="{Binding LoadFromFileCommand}"
                                    ToolTip="{loc:Loc Tip.ModelfileOpen}" Style="{DynamicResource GhostButtonStyle}" Margin="0,0,4,0" />
                            <Button Grid.Column="2" Content="{loc:Loc Modelfile.Save}" Command="{Binding SaveToFileCommand}"
                                    ToolTip="{loc:Loc Tip.ModelfileSave}" Style="{DynamicResource GhostButtonStyle}" />
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Padding="14,10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{loc:Loc Modelfile.Name}" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold" FontSize="12" />
                            <TextBox Grid.Column="1" Text="{Binding NewModelName, UpdateSourceTrigger=PropertyChanged}" ToolTip="{loc:Loc Tip.ModelfileName}" />
                        </Grid>
                    </Border>

                    <TextBox Grid.Row="2" Text="{Binding ModelfileText, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" AcceptsTab="True" FontFamily="Consolas" FontSize="12"
                             TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto"
                             VerticalScrollBarVisibility="Auto" BorderThickness="0"
                             Background="{DynamicResource SurfaceSunkenBrush}" />

                    <Border Grid.Row="3" Background="#CC0F172A" Visibility="{Binding IsBusy, Converter={StaticResource BoolVis}}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="⏳" FontFamily="Segoe UI Emoji, Segoe UI Symbol, Segoe UI"
                                       FontSize="20" Foreground="White" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding BusyMessage}" Foreground="White" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="4" Background="{DynamicResource SurfaceAltBrush}" Padding="14,10" CornerRadius="0,0,10,10">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="{loc:Loc Modelfile.Validate}" Command="{Binding ValidateCommand}"
                                    ToolTip="{loc:Loc Tip.ModelfileValidate}" Style="{DynamicResource SecondaryButtonStyle}" Margin="0,0,8,0" />
                            <Button Content="{loc:Loc Modelfile.CreateModel}" Command="{Binding CreateModelCommand}"
                                    ToolTip="{loc:Loc Tip.ModelfileCreate}" Style="{DynamicResource AccentButtonStyle}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{DynamicResource CardStyle}" Margin="12,0,0,0" Padding="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">
                        <TextBlock Text="{loc:Loc Modelfile.QuickGenerator}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,12" />

                        <TextBlock Style="{DynamicResource Text.Label}" Text="{loc:Loc Modelfile.From}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding FromModel, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="{loc:Loc Tip.ModelfileFrom}" Margin="0,0,0,12" />

                        <TextBlock Style="{DynamicResource Text.Label}" Text="{loc:Loc Modelfile.System}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding SystemPrompt, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="{loc:Loc Tip.ModelfileSystem}" AcceptsReturn="True" Height="64"
                                 TextWrapping="Wrap" Margin="0,0,0,12" />

                        <TextBlock Style="{DynamicResource Text.Label}" Text="{loc:Loc Modelfile.Template}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding Template, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="{loc:Loc Tip.ModelfileTemplate}" AcceptsReturn="True" Height="64"
                                 TextWrapping="Wrap" FontFamily="Consolas" FontSize="11" Margin="0,0,0,12" />

                        <Button Content="{loc:Loc Modelfile.Generate}" Command="{Binding GenerateFromParametersCommand}"
                                ToolTip="{loc:Loc Tip.ModelfileGenerate}" HorizontalAlignment="Stretch" Margin="0,0,0,16" />

                        <Border Background="{DynamicResource DividerBrush}" Height="1" Margin="0,0,0,16" />

                        <TextBlock Text="{loc:Loc Modelfile.Parameters}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8" />
                        <ItemsControl ItemsSource="{Binding AvailableParameters}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Key}" VerticalAlignment="Center" FontFamily="Consolas" FontSize="12" />
                                        <Button Grid.Column="1" Content="+" Width="24" Height="24"
                                                Style="{DynamicResource GhostButtonStyle}"
                                                Command="{Binding DataContext.AddParameterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>