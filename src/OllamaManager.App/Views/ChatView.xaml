<UserControl x:Class="OllamaManager.App.Views.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:OllamaManager.App.Localization"
             xmlns:conv="clr-namespace:OllamaManager.App.Localization"
             xmlns:vm="clr-namespace:OllamaManager.App.ViewModels"
             mc:Ignorable="d"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance Type=vm:ChatViewModel}"
             Keyboard.PreviewKeyDown="OnPreviewKeyDown">
    <UserControl.Resources>
        <conv:LocConverter x:Key="Loc" />
        <conv:BoolToVisibilityConverter x:Key="BoolVis" />
        <conv:InverseBoolConverter x:Key="InverseBool" />
        <conv:IndexOffsetConverter x:Key="IndexOffset" />

        <!-- Read-only selectable text box used inside message bubbles so users can highlight
             and right-click to copy chat content (WPF TextBlock doesn't support selection). -->
        <Style x:Key="SelectableTextStyle" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CaretBrush" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource PrimarySoftBrush}" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>

        <!-- ============ MARKDOWN SEGMENT TEMPLATES ============ -->
        <DataTemplate x:Key="MdText">
            <TextBox Style="{StaticResource SelectableTextStyle}" Text="{Binding Text}" />
        </DataTemplate>

        <DataTemplate x:Key="MdBold">
            <TextBox Style="{StaticResource SelectableTextStyle}" Text="{Binding Text}" FontWeight="SemiBold" />
        </DataTemplate>

        <DataTemplate x:Key="MdItalic">
            <TextBox Style="{StaticResource SelectableTextStyle}" Text="{Binding Text}" FontStyle="Italic" />
        </DataTemplate>

        <DataTemplate x:Key="MdInlineCode">
            <Border Background="#25282F" CornerRadius="4" Padding="5,1" Margin="0,2"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <TextBox Style="{StaticResource SelectableTextStyle}" Text="{Binding Text}"
                         FontFamily="Consolas, Courier New, Cascadia Mono"
                         Foreground="{DynamicResource AccentBrush}" FontSize="13" />
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="MdCodeBlock">
            <Border Background="#1A1D24" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="12,10" Margin="0,6,0,4">
                <Grid>
                    <StackPanel>
                        <DockPanel LastChildFill="True" Margin="0,0,0,6"
                                   Visibility="{Binding Language, Converter={StaticResource BoolVis}, FallbackValue=Collapsed}">
                            <TextBlock DockPanel.Dock="Left" Text="{Binding Language}" FontSize="10"
                                       Foreground="{DynamicResource TextTertiaryBrush}" FontFamily="Consolas, Courier New" />
                        </DockPanel>
                        <TextBox Style="{StaticResource SelectableTextStyle}" Text="{Binding Text}"
                                 FontFamily="Consolas, Courier New, Cascadia Mono"
                                 Foreground="{DynamicResource TextBrush}" FontSize="13"
                                 TextWrapping="NoWrap" AcceptsReturn="True"
                                 HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />
                    </StackPanel>
                    <!-- ChatGPT-style copy button in the top-right corner of the code block -->
                    <Button HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="0,-6,-6,0" Padding="7,3" Cursor="Hand"
                            Background="{DynamicResource SurfaceAltBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            Click="OnCodeBlockCopyClick" Tag="{Binding Text}"
                            ToolTip="复制代码"
                            FontFamily="Segoe UI Emoji, Segoe UI, Microsoft YaHei UI">
                        <StackPanel x:Name="CopyPanel" Orientation="Horizontal">
                            <TextBlock Text="📋" FontSize="11" Margin="0,0,4,0" FontFamily="Segoe UI Emoji" />
                            <TextBlock Text="复制" FontSize="10" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="MdHeading1">
            <TextBox Style="{StaticResource SelectableTextStyle}" Text="{Binding Text}"
                     FontSize="22" FontWeight="Bold" Margin="0,14,0,6" />
        </DataTemplate>

        <DataTemplate x:Key="MdHeading2">
            <TextBox Style="{StaticResource SelectableTextStyle}" Text="{Binding Text}"
                     FontSize="18" FontWeight="SemiBold" Margin="0,12,0,5" />
        </DataTemplate>

        <DataTemplate x:Key="MdHeading3">
            <TextBox Style="{StaticResource SelectableTextStyle}" Text="{Binding Text}"
                     FontSize="15" FontWeight="SemiBold" Margin="0,10,0,4" />
        </DataTemplate>

        <DataTemplate x:Key="MdHeading4">
            <TextBox Style="{StaticResource SelectableTextStyle}" Text="{Binding Text}"
                     FontSize="14" FontWeight="SemiBold" Margin="0,8,0,3"
                     Foreground="{DynamicResource TextSecondaryBrush}" />
        </DataTemplate>

        <DataTemplate x:Key="MdBulletList">
            <ItemsControl ItemsSource="{Binding Children}" Margin="0,4,0,4">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:MarkdownSegment}">
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="•" Foreground="{DynamicResource PrimaryBrush}"
                                       FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Top" />
                            <TextBox Grid.Column="1" Style="{StaticResource SelectableTextStyle}"
                                     Text="{Binding Text}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DataTemplate>

        <DataTemplate x:Key="MdNumberedList">
            <ItemsControl ItemsSource="{Binding Children}" Margin="0,4,0,4" AlternationCount="999">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:MarkdownSegment}">
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Foreground="{DynamicResource PrimaryBrush}" FontSize="14" FontWeight="SemiBold"
                                       HorizontalAlignment="Right" Margin="0,0,8,0"
                                       Text="{Binding RelativeSource={RelativeSource AncestorType=ItemsControl}, Path=(ItemsControl.AlternationIndex), Converter={StaticResource IndexOffset}, ConverterParameter=1}" />
                            <TextBox Grid.Column="1" Style="{StaticResource SelectableTextStyle}"
                                     Text="{Binding Text}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DataTemplate>

        <DataTemplate x:Key="MdQuote">
            <Border BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="3,0,0,0" Padding="12,4,8,4" Margin="0,4,0,4">
                <TextBox Style="{StaticResource SelectableTextStyle}" Text="{Binding Text}"
                         FontStyle="Italic" Foreground="{DynamicResource TextSecondaryBrush}" />
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="MdHorizontalRule">
            <Border Background="{DynamicResource DividerBrush}" Height="1" Margin="0,10,0,8" />
        </DataTemplate>

        <DataTemplate x:Key="MdLink">
            <TextBlock FontSize="14" LineHeight="24">
                <Hyperlink NavigateUri="{Binding Url}" RequestNavigate="OnLinkClick"
                           Foreground="{DynamicResource PrimaryBrush}">
                    <Run Text="{Binding Text}" />
                </Hyperlink>
            </TextBlock>
        </DataTemplate>

        <!-- Style trigger to pick the right Markdown template by Kind -->
        <Style x:Key="MarkdownSegmentStyle" TargetType="ContentControl">
            <Setter Property="ContentTemplate" Value="{StaticResource MdText}" />
            <Setter Property="Focusable" Value="False" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="Bold">
                    <Setter Property="ContentTemplate" Value="{StaticResource MdBold}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Italic">
                    <Setter Property="ContentTemplate" Value="{StaticResource MdItalic}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="InlineCode">
                    <Setter Property="ContentTemplate" Value="{StaticResource MdInlineCode}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="CodeBlock">
                    <Setter Property="ContentTemplate" Value="{StaticResource MdCodeBlock}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Heading1">
                    <Setter Property="ContentTemplate" Value="{StaticResource MdHeading1}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Heading2">
                    <Setter Property="ContentTemplate" Value="{StaticResource MdHeading2}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Heading3">
                    <Setter Property="ContentTemplate" Value="{StaticResource MdHeading3}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Heading4">
                    <Setter Property="ContentTemplate" Value="{StaticResource MdHeading4}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="BulletList">
                    <Setter Property="ContentTemplate" Value="{StaticResource MdBulletList}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="NumberedList">
                    <Setter Property="ContentTemplate" Value="{StaticResource MdNumberedList}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Quote">
                    <Setter Property="ContentTemplate" Value="{StaticResource MdQuote}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="HorizontalRule">
                    <Setter Property="ContentTemplate" Value="{StaticResource MdHorizontalRule}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Link">
                    <Setter Property="ContentTemplate" Value="{StaticResource MdLink}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Tiny ghost button style used for chat action buttons -->
        <Style x:Key="ChatActionButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="9,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimarySoftBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Menu item style for chat context menus: emoji icon + text -->
        <Style x:Key="ChatContextMenuItem" TargetType="MenuItem">
            <Setter Property="FontFamily" Value="Segoe UI Emoji, Segoe UI, Microsoft YaHei UI, PingFang SC" />
        </Style>

        <!-- Right-click context menu shared by all chat bubbles. Click handlers live in code-behind. -->
        <ContextMenu x:Key="ChatBubbleContextMenu" ContextMenuOpening="OnChatContextMenuOpening">
            <MenuItem Style="{StaticResource ChatContextMenuItem}" Command="ApplicationCommands.Copy">
                <MenuItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📋" FontSize="12" Margin="0,0,6,0" />
                        <TextBlock Text="复制" />
                    </StackPanel>
                </MenuItem.Header>
            </MenuItem>
            <MenuItem Style="{StaticResource ChatContextMenuItem}" Click="OnCopyFullClick">
                <MenuItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📄" FontSize="12" Margin="0,0,6,0" />
                        <TextBlock Text="复制全文" />
                    </StackPanel>
                </MenuItem.Header>
            </MenuItem>
            <MenuItem Style="{StaticResource ChatContextMenuItem}" Command="ApplicationCommands.SelectAll">
                <MenuItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🅰" FontSize="12" Margin="0,0,6,0" />
                        <TextBlock Text="全选" />
                    </StackPanel>
                </MenuItem.Header>
            </MenuItem>
            <Separator />
            <MenuItem Style="{StaticResource ChatContextMenuItem}" Click="OnRegenerateFromMenuClick"
                      x:Name="MenuRegenerate">
                <MenuItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔄" FontSize="12" Margin="0,0,6,0" />
                        <TextBlock Text="重试" />
                    </StackPanel>
                </MenuItem.Header>
            </MenuItem>
            <MenuItem Style="{StaticResource ChatContextMenuItem}" Click="OnDeleteFromMenuClick"
                      x:Name="MenuDelete">
                <MenuItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🗑" FontSize="12" Margin="0,0,6,0" />
                        <TextBlock Text="删除" />
                    </StackPanel>
                </MenuItem.Header>
            </MenuItem>
        </ContextMenu>

        <DataTemplate x:Key="UserBubbleTemplate" DataType="{x:Type vm:ChatTurnViewModel}">
            <Border CornerRadius="16,16,4,16" Padding="14,11" Margin="60,8,0,8" HorizontalAlignment="Right" MaxWidth="700"
                    ContextMenu="{StaticResource ChatBubbleContextMenu}">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#3B82F6" Offset="0" />
                        <GradientStop Color="#6366F1" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.30" Color="#3B82F6" />
                </Border.Effect>
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Images}" Margin="0,0,0,8"
                                  Visibility="{Binding HasImages, Converter={StaticResource BoolVis}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" MaxWidth="500" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:AttachedImage}">
                                <Border Margin="0,0,6,6" CornerRadius="8" Cursor="Hand"
                                        BorderBrush="#33FFFFFF" BorderThickness="1"
                                        Background="#22FFFFFF"
                                        MouseLeftButtonUp="OnThumbnailClick"
                                        Tag="{Binding}" ToolTip="{Binding DisplaySize}">
                                    <Grid>
                                        <Image Source="{Binding Thumbnail}" MaxWidth="160" MaxHeight="160" Stretch="Uniform" />
                                        <Border VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,4,4"
                                                Background="#99000000" CornerRadius="8" Padding="5,2">
                                            <TextBlock Text="🔍" FontSize="10" Foreground="White" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding Content}" Foreground="White" TextWrapping="Wrap" LineHeight="22" FontSize="14" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="AssistantStreamTemplate" DataType="{x:Type vm:ChatTurnViewModel}">
            <Border Background="{DynamicResource AiBubbleBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="16,16,16,4" Padding="16,12" Margin="0,8,60,8" HorizontalAlignment="Left" MaxWidth="780">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.20" Color="Black" />
                </Border.Effect>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Border Width="22" Height="22" CornerRadius="11" Background="{DynamicResource PrimarySoftBrush}" VerticalAlignment="Center">
                            <TextBlock Text="M" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="AI" FontWeight="SemiBold" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" />
                        <TextBlock Text="{Binding Stats}" Margin="8,0,0,0" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding Content}" TextWrapping="Wrap" LineHeight="24" FontSize="14"
                               Foreground="{DynamicResource TextBrush}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="AssistantDoneTemplate" DataType="{x:Type vm:ChatTurnViewModel}">
            <Border Background="{DynamicResource AiBubbleBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="16,16,16,4" Padding="16,12" Margin="0,8,60,8" HorizontalAlignment="Left" MaxWidth="780"
                    ContextMenu="{StaticResource ChatBubbleContextMenu}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.20" Color="Black" />
                </Border.Effect>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Border Width="22" Height="22" CornerRadius="11" Background="{DynamicResource PrimarySoftBrush}" VerticalAlignment="Center">
                            <TextBlock Text="M" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="AI" FontWeight="SemiBold" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" />
                        <TextBlock Text="{Binding Stats}" Margin="8,0,0,0" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding Segments}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:MarkdownSegment}">
                                <ContentControl Content="{Binding}" Style="{StaticResource MarkdownSegmentStyle}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Action buttons row: copy / regenerate / delete -->
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0"
                                Visibility="{Binding IsFinished, Converter={StaticResource BoolVis}}">
                        <Button x:Name="ActionCopyBtn" Style="{StaticResource ChatActionButton}" Margin="0,0,6,0"
                                Command="{Binding DataContext.CopyTurnCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                Click="OnActionCopyClick"
                                ToolTip="复制全文">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📋" FontSize="12" Margin="0,0,5,0" FontFamily="Segoe UI Emoji" />
                                <TextBlock x:Name="ActionCopyLabel" Text="复制" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="ActionRegenBtn" Style="{StaticResource ChatActionButton}" Margin="0,0,6,0"
                                Command="{Binding DataContext.RegenerateTurnCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                Click="OnActionRegenClick"
                                ToolTip="用相同问题重新生成">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔄" FontSize="12" Margin="0,0,5,0" FontFamily="Segoe UI Emoji" />
                                <TextBlock x:Name="ActionRegenLabel" Text="重试" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="ActionDeleteBtn" Style="{StaticResource ChatActionButton}"
                                Command="{Binding DataContext.DeleteTurnCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                Click="OnActionDeleteClick"
                                ToolTip="删除这条消息">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🗑" FontSize="12" Margin="0,0,5,0" FontFamily="Segoe UI Emoji" />
                                <TextBlock x:Name="ActionDeleteLabel" Text="删除" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="AssistantThinkingTemplate" DataType="{x:Type vm:ChatTurnViewModel}">
            <Border Background="{DynamicResource AiBubbleBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="16,16,16,4" Padding="16,12" Margin="0,8,60,8" HorizontalAlignment="Left" MaxWidth="780">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.20" Color="Black" />
                </Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <Border Width="22" Height="22" CornerRadius="11" Background="{DynamicResource PrimarySoftBrush}" VerticalAlignment="Center">
                        <TextBlock Text="M" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="AI 正在思考" FontWeight="SemiBold" FontSize="12" Margin="8,0,10,0" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="7" Height="7" Margin="0,0,5,0" Fill="{DynamicResource PrimaryBrush}" Opacity="0.3">
                            <Ellipse.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.3" To="1.0" Duration="0:0:0.6" BeginTime="0:0:0" AutoReverse="True" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Ellipse.Triggers>
                        </Ellipse>
                        <Ellipse Width="7" Height="7" Margin="0,0,5,0" Fill="{DynamicResource PrimaryBrush}" Opacity="0.3">
                            <Ellipse.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.3" To="1.0" Duration="0:0:0.6" BeginTime="0:0:0.2" AutoReverse="True" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Ellipse.Triggers>
                        </Ellipse>
                        <Ellipse Width="7" Height="7" Fill="{DynamicResource PrimaryBrush}" Opacity="0.3">
                            <Ellipse.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.3" To="1.0" Duration="0:0:0.6" BeginTime="0:0:0.4" AutoReverse="True" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Ellipse.Triggers>
                        </Ellipse>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <Style x:Key="ChatItemStyle" TargetType="ContentControl">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="ContentTemplate" Value="{StaticResource AssistantDoneTemplate}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Role}" Value="User">
                    <Setter Property="ContentTemplate" Value="{StaticResource UserBubbleTemplate}" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Role}" Value="Assistant" />
                        <Condition Binding="{Binding IsThinking}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="ContentTemplate" Value="{StaticResource AssistantThinkingTemplate}" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Role}" Value="Assistant" />
                        <Condition Binding="{Binding IsStreaming}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="ContentTemplate" Value="{StaticResource AssistantStreamTemplate}" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CapabilityBadge" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="9,3" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="ModeToggle" TargetType="ToggleButton">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" CornerRadius="12" Padding="{TemplateBinding Padding}"
                                Background="{DynamicResource SurfaceAltBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#3B82F6" Offset="0" />
                                            <GradientStop Color="#6366F1" Offset="1" />
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Round send button -->
        <Style x:Key="SendRoundButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinWidth" Value="44" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Width="44" Height="44" CornerRadius="22">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#3B82F6" Offset="0" />
                                    <GradientStop Color="#6366F1" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.40" Color="#3B82F6" />
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.8" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: model selector + refresh/clear -->
        <Border Grid.Row="0" Style="{DynamicResource CardStyle}" Margin="0,0,0,10" Padding="18,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="32" Height="32" CornerRadius="8" Background="{DynamicResource PrimarySoftBrush}" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="M" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Grid.Column="1" Text="{Binding SelectedModel, FallbackValue=选择模型}"
                           VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" />
                <Button Grid.Column="2" Content="{loc:Loc Common.Refresh}" Command="{Binding ReloadModelsCommand}"
                        Style="{DynamicResource SecondaryButtonStyle}" Margin="0,0,8,0" />
                <Button Grid.Column="3" Content="{loc:Loc Chat.Clear}" Command="{Binding ClearCommand}"
                        Style="{DynamicResource SecondaryButtonStyle}" />
            </Grid>
        </Border>

        <!-- Capability row + mode toggles -->
        <Border Grid.Row="1" Style="{DynamicResource CardStyle}" Margin="0,0,0,10" Padding="16,11">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{loc:Loc Chat.Capabilities}" FontSize="11" FontWeight="SemiBold" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="{DynamicResource TextTertiaryBrush}" />
                    <ItemsControl ItemsSource="{Binding ModelCapabilities}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource CapabilityBadge}">
                                    <TextBlock Text="{Binding}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{loc:Loc Chat.Probing}" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextTertiaryBrush}"
                               Visibility="{Binding IsProbingCapabilities, Converter={StaticResource BoolVis}}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <ToggleButton Style="{StaticResource ModeToggle}" IsChecked="{Binding EnableStream}" ToolTip="{loc:Loc Chat.Tip.Stream}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="≈" FontSize="13" Margin="0,0,4,0" FontFamily="Segoe UI Symbol" />
                            <TextBlock Text="{loc:Loc Chat.Mode.Stream}" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton Style="{StaticResource ModeToggle}" IsChecked="{Binding EnableThinking}"
                                  IsEnabled="{Binding IsThinkingCapable}"
                                  ToolTip="{loc:Loc Chat.Tip.Thinking}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🧠" FontSize="11" Margin="0,0,4,0" />
                            <TextBlock Text="{loc:Loc Chat.Mode.Thinking}" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton Style="{StaticResource ModeToggle}" IsChecked="{Binding EnableVision}"
                                  IsEnabled="{Binding IsVisionCapable}"
                                  ToolTip="{loc:Loc Chat.Tip.Vision}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="👁" FontSize="11" Margin="0,0,4,0" />
                            <TextBlock Text="{loc:Loc Chat.Mode.Vision}" />
                        </StackPanel>
                    </ToggleButton>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Chat area -->
        <Border Grid.Row="2" Style="{DynamicResource CardStyle}" Padding="0">
            <Grid>
                <ScrollViewer x:Name="ChatScroll" VerticalScrollBarVisibility="Auto" Padding="20">
                    <ItemsControl ItemsSource="{Binding Turns}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ChatTurnViewModel}">
                                <ContentControl Content="{Binding}" Style="{StaticResource ChatItemStyle}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Border VerticalAlignment="Center" HorizontalAlignment="Center"
                        Style="{DynamicResource CardSubtleStyle}"
                        Visibility="{Binding IsChatEmpty, Converter={StaticResource BoolVis}}"
                        Padding="24,18">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="💬" FontSize="22" Margin="0,0,12,0" FontFamily="Segoe UI Emoji" />
                        <TextBlock Text="{loc:Loc Chat.EmptyHint}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Input area -->
        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,10">
                <Border Style="{DynamicResource CardSubtleStyle}" Padding="10,8" Margin="0,0,0,8"
                        Visibility="{Binding HasAttachedImages, Converter={StaticResource BoolVis}}">
                    <ItemsControl ItemsSource="{Binding AttachedImages}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,8,0" Padding="8,6" CornerRadius="10" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🖼" FontSize="12" Margin="0,0,6,0" />
                                        <TextBlock Text="{Binding Path}" MaxWidth="200" TextTrimming="CharacterEllipsis" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <Button Content="✕" Margin="8,0,0,0" Padding="5,1" FontSize="10"
                                                Style="{DynamicResource GhostButtonStyle}"
                                                Command="{Binding DataContext.RemoveImageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <Border Style="{DynamicResource CardSubtleStyle}" Padding="12,8"
                        Visibility="{Binding StatusText, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="{Binding StatusText}" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                </Border>
            </StackPanel>

            <!-- Input card -->
            <Border Grid.Row="1" Style="{DynamicResource CardStyle}" Padding="14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="🖼" ToolTip="{loc:Loc Chat.AttachImage}"
                            Command="{Binding AttachImageCommand}"
                            Visibility="{Binding IsVisionCapable, Converter={StaticResource BoolVis}}"
                            IsEnabled="{Binding IsVisionCapable}"
                            Style="{DynamicResource SecondaryButtonStyle}" Margin="0,0,8,0" Width="44" Height="44" Padding="0" />
                    <TextBox Grid.Column="1" Text="{Binding Draft, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="48" MaxHeight="140" VerticalScrollBarVisibility="Auto"
                             Padding="4,8" FontSize="14" BorderThickness="0" Background="Transparent"
                             ToolTip="{loc:Loc Chat.InputTip}" />
                    <Grid Grid.Column="2" Margin="10,0,0,0">
                        <Button Style="{StaticResource SendRoundButton}" Command="{Binding SendCommand}"
                                Visibility="{Binding IsGenerating, Converter={StaticResource InverseBool}}" ToolTip="{loc:Loc Chat.Send}">
                            <Path Width="18" Height="18" Stretch="Uniform" Stroke="White" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Fill="Transparent"
                                  Data="M 3 10 L 21 3 L 14 21 L 11 13 L 3 10 Z" />
                        </Button>
                        <Button Style="{StaticResource SendRoundButton}" Command="{Binding CancelCommand}"
                                Visibility="{Binding IsGenerating, Converter={StaticResource BoolVis}}" ToolTip="{loc:Loc Chat.Cancel}">
                            <Border Width="14" Height="14" CornerRadius="2" Background="White" />
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
