<UserControl x:Class="OllamaManager.App.Views.RunningView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:OllamaManager.App.Localization"
             xmlns:conv="clr-namespace:OllamaManager.App.Localization">
    <UserControl.Resources>
        <conv:LocConverter x:Key="Loc" />
        <conv:BoolToVisibilityConverter x:Key="BoolVis" />
        <conv:NullToBoolConverter x:Key="NullBool" />
    </UserControl.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Style="{DynamicResource Text.H1}" Text="{loc:Loc Running.Title}" />
            <TextBlock Style="{DynamicResource Text.Caption}" Text="{loc:Loc Running.Subtitle}" Margin="0,4,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Style="{DynamicResource CardStyle}" Margin="0,0,0,16" Padding="16,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="{loc:Loc Common.Refresh}" Command="{Binding LoadCommand}"
                        ToolTip="{loc:Loc Running.RefreshTip}" Margin="0,0,8,0" />
                <Button Grid.Column="1" Content="{loc:Loc Models.Run}" Command="{Binding StartCommand}"
                        ToolTip="{loc:Loc Tip.RunModel}" Style="{DynamicResource SecondaryButtonStyle}" Margin="0,0,8,0" />
                <Button Grid.Column="2" Content="{loc:Loc Running.Unload}" Command="{Binding UnloadCommand}"
                        ToolTip="{loc:Loc Tip.UnloadModel}" Style="{DynamicResource SecondaryButtonStyle}" Margin="0,0,8,0" />
                <Button Grid.Column="4" Content="{loc:Loc Running.ReleaseAll}" Command="{Binding ReleaseAllCommand}"
                        ToolTip="{loc:Loc Tip.ReleaseAllModels}" Style="{DynamicResource DangerButtonStyle}" />
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{DynamicResource CardSubtleStyle}"
                Visibility="{Binding OperationStatus, Converter={StaticResource NullBool}}"
                Padding="14,8" VerticalAlignment="Top" Margin="0,0,0,8"
                Panel.ZIndex="2">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="⏳" FontFamily="Segoe UI Emoji, Segoe UI Symbol, Segoe UI"
                           FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding OperationStatus}" VerticalAlignment="Center"
                           FontWeight="SemiBold" FontSize="12" />
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{DynamicResource CardStyle}" Padding="0">
            <Grid>
                <DataGrid ItemsSource="{Binding RunningModels}" SelectedItem="{Binding SelectedModel}"
                          BorderThickness="0" Background="Transparent">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="{loc:Loc Running.Model}" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="8" Height="8" Margin="0,0,10,0" VerticalAlignment="Center"
                                                 Fill="{DynamicResource SuccessBrush}" />
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontWeight="SemiBold" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="{loc:Loc Running.Size}" Binding="{Binding DisplaySize}" Width="120" />
                        <DataGridTextColumn Header="{loc:Loc Running.VRAM}" Binding="{Binding DisplayVram}" Width="120" />
                        <DataGridTextColumn Header="{loc:Loc Running.Context}" Binding="{Binding ContextLength}" Width="100" />
                        <DataGridTextColumn Header="{loc:Loc Running.Expires}" Binding="{Binding ExpiresAt, StringFormat='{}{0:HH:mm:ss}'}" Width="100" />
                    </DataGrid.Columns>
                </DataGrid>

                <Border VerticalAlignment="Center" HorizontalAlignment="Center"
                        Style="{DynamicResource CardSubtleStyle}" Padding="20,14"
                        Visibility="{Binding RunningModels.Count, Converter={StaticResource BoolVis}, ConverterParameter=Invert}">
                    <StackPanel>
                        <TextBlock Text="💤" FontFamily="Segoe UI Emoji, Segoe UI Symbol, Segoe UI"
                                   FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,8" />
                        <TextBlock Text="{loc:Loc Running.Empty}" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Text="{loc:Loc Running.EmptyHint}" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>