<Window x:Class="OllamaManager.App.Views.ImageViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="图片预览"
        Height="720" Width="980"
        MinHeight="300" MinWidth="400"
        WindowStartupLocation="CenterOwner"
        Background="#E6111827"
        Foreground="White"
        ShowInTaskbar="False"
        TextElement.Foreground="White"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        PreviewKeyDown="OnPreviewKeyDown">
    <Grid>
        <Image x:Name="ViewerImage"
               Stretch="Uniform"
               Margin="24"
               Source="{Binding ImageSource}"
               MouseLeftButtonUp="OnImageClick"
               Cursor="Hand" />

        <Border VerticalAlignment="Top"
                HorizontalAlignment="Right"
                Margin="0,16,16,0"
                Background="#80000000"
                CornerRadius="14"
                Padding="10,5"
                Cursor="Hand"
                MouseLeftButtonUp="OnCloseClick">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="✕" FontSize="14" Foreground="White" Margin="0,0,6,0" VerticalAlignment="Center" />
                <TextBlock x:Name="CloseText" Text="关闭" FontSize="12" Foreground="White" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <Border VerticalAlignment="Top"
                HorizontalAlignment="Left"
                Margin="16,16,0,0"
                Background="#80000000"
                CornerRadius="14"
                Padding="10,5">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="FileNameText" Text="{Binding FileName}" FontSize="11" Foreground="White" VerticalAlignment="Center" />
                <TextBlock Text=" · " FontSize="11" Foreground="#88FFFFFF" VerticalAlignment="Center" />
                <TextBlock x:Name="DimensionsText" Text="{Binding Dimensions}" FontSize="11" Foreground="#CCFFFFFF" VerticalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Window>