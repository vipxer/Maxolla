<UserControl x:Class="OllamaManager.App.Views.GpuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:OllamaManager.App.Localization"
             xmlns:conv="clr-namespace:OllamaManager.App.Localization"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">
    <UserControl.Resources>
        <conv:LocConverter x:Key="Loc" />
        <conv:BoolToVisibilityConverter x:Key="BoolVis" />
    </UserControl.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <TextBlock Style="{DynamicResource Text.H1}" Text="{loc:Loc Gpu.Title}" />
            <TextBlock Style="{DynamicResource Text.Caption}" Text="{Binding BackendName}" Margin="12,0,0,0" VerticalAlignment="Center" />
            <Button Content="{loc:Loc Common.Refresh}" Command="{Binding RefreshCommand}" Margin="20,0,0,0" Style="{DynamicResource SecondaryButtonStyle}" />
            <CheckBox Content="{loc:Loc Gpu.HistoryToggle}" IsChecked="{Binding HistoryEnabled}" Margin="20,0,0,0" VerticalAlignment="Center" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="350" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{DynamicResource CardStyle}" Padding="0">
                <DataGrid ItemsSource="{Binding Gpus}" SelectedItem="{Binding SelectedGpu}" BorderThickness="0" Background="Transparent">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{loc:Loc Gpu.Index}" Binding="{Binding Index}" Width="50" />
                        <DataGridTextColumn Header="{loc:Loc Gpu.Name}" Binding="{Binding Name}" Width="*" />
                        <DataGridTextColumn Header="{loc:Loc Gpu.Utilization}" Binding="{Binding GpuUtilization, StringFormat='{}{0:F1}%'}" Width="100" />
                        <DataGridTextColumn Header="{loc:Loc Gpu.Memory}" Binding="{Binding DisplayMemoryUsage}" Width="140" />
                        <DataGridTextColumn Header="{loc:Loc Gpu.Temperature}" Binding="{Binding Temperature, StringFormat='{}{0:F0}°C'}" Width="100" />
                        <DataGridTextColumn Header="{loc:Loc Gpu.Power}" Binding="{Binding PowerUsage, StringFormat='{}{0:F0}W'}" Width="80" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Border Grid.Column="1" Style="{DynamicResource CardStyle}" Margin="12,0,0,0" Padding="20">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Style="{DynamicResource Text.H3}" Text="{loc:Loc Gpu.SelectedGpu}" Margin="0,0,0,12" />
                        <Grid Visibility="{Binding SelectedGpu, Converter={StaticResource BoolVis}}">
                            <StackPanel>
                                <TextBlock Text="{Binding SelectedGpu.Name}" Style="{DynamicResource Text.H3}" TextWrapping="Wrap" />
                                <TextBlock Style="{DynamicResource Text.Caption}" Margin="0,4,0,0">
                                    <Run Text="{loc:Loc Gpu.Driver}" />
                                    <Run Text="{Binding SelectedGpu.DriverVersion, Mode=OneWay}" FontWeight="SemiBold" />
                                </TextBlock>

                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Grid.Column="0">
                                        <TextBlock Style="{DynamicResource Text.Label}" Text="{loc:Loc Gpu.ClockGpu}" />
                                        <TextBlock Text="{Binding SelectedGpu.GraphicsClock, StringFormat='{}{0} MHz'}" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="1">
                                        <TextBlock Style="{DynamicResource Text.Label}" Text="{loc:Loc Gpu.ClockMem}" />
                                        <TextBlock Text="{Binding SelectedGpu.MemoryClock, StringFormat='{}{0} MHz'}" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock Style="{DynamicResource Text.H3}" Text="{loc:Loc Gpu.Processes}" Margin="0,20,0,8" />
                                <DataGrid ItemsSource="{Binding Processes}" MaxHeight="200" BorderThickness="1">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="60" />
                                        <DataGridTextColumn Header="{loc:Loc Gpu.ProcessName}" Binding="{Binding ProcessName}" Width="*" />
                                        <DataGridTextColumn Header="{loc:Loc Gpu.Memory}" Binding="{Binding DisplayMemory}" Width="80" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="0,16,0,0"
              Visibility="{Binding HistoryEnabled, Converter={StaticResource BoolVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{DynamicResource CardStyle}" Margin="0,0,6,0" Padding="16,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="160" />
                    </Grid.RowDefinitions>
                    <TextBlock Style="{DynamicResource Text.H3}" Text="{loc:Loc Gpu.Utilization}" />
                    <lvc:CartesianChart Grid.Row="1"
                                        Series="{Binding UtilSeries}"
                                        XAxes="{Binding HistoryXAxes}"
                                        YAxes="{Binding UtilYAxes}"
                                        LegendPosition="Hidden"
                                        ZoomMode="X" />
                </Grid>
            </Border>
            <Border Grid.Column="1" Style="{DynamicResource CardStyle}" Margin="6,0,0,0" Padding="16,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="160" />
                    </Grid.RowDefinitions>
                    <TextBlock Style="{DynamicResource Text.H3}" Text="{loc:Loc Gpu.Memory}" />
                    <lvc:CartesianChart Grid.Row="1"
                                        Series="{Binding MemSeries}"
                                        XAxes="{Binding HistoryXAxes}"
                                        YAxes="{Binding MemYAxes}"
                                        LegendPosition="Hidden"
                                        ZoomMode="X" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>