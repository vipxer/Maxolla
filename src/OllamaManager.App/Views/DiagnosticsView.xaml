<UserControl x:Class="OllamaManager.App.Views.DiagnosticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:OllamaManager.App.Localization"
             xmlns:conv="clr-namespace:OllamaManager.App.Localization">
    <UserControl.Resources>
        <conv:LocConverter x:Key="Loc" />
        <conv:BoolToVisibilityConverter x:Key="BoolVis" />
    </UserControl.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Style="{DynamicResource Text.H1}" Text="{loc:Loc Diagnostics.Title}" />
            <TextBlock Style="{DynamicResource Text.Caption}" Text="{loc:Loc Diagnostics.Subtitle}" Margin="0,4,0,0" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <UniformGrid Grid.Column="0" Rows="1" Columns="3">
                <Border Style="{DynamicResource CardStyle}" Margin="0,0,6,0" Padding="16,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{DynamicResource Text.Label}" Text="{loc:Loc Diagnostics.Ok}" />
                            <TextBlock Text="{Binding OkCount}" FontSize="24" FontWeight="SemiBold"
                                       Foreground="{DynamicResource SuccessBrush}" Margin="0,4,0,0" />
                        </StackPanel>
                        <Border Grid.Column="1" Width="36" Height="36" CornerRadius="8"
                                Background="{DynamicResource SuccessSoftBrush}" VerticalAlignment="Center">
                            <TextBlock Text="✓" FontWeight="Bold" FontSize="16"
                                       Foreground="{DynamicResource SuccessBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Border>
                <Border Style="{DynamicResource CardStyle}" Margin="3,0" Padding="16,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{DynamicResource Text.Label}" Text="{loc:Loc Diagnostics.Warnings}" />
                            <TextBlock Text="{Binding WarningCount}" FontSize="24" FontWeight="SemiBold"
                                       Foreground="{DynamicResource WarningBrush}" Margin="0,4,0,0" />
                        </StackPanel>
                        <Border Grid.Column="1" Width="36" Height="36" CornerRadius="8"
                                Background="{DynamicResource WarningSoftBrush}" VerticalAlignment="Center">
                            <TextBlock Text="!" FontWeight="Bold" FontSize="16"
                                       Foreground="{DynamicResource WarningBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Border>
                <Border Style="{DynamicResource CardStyle}" Margin="6,0,0,0" Padding="16,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{DynamicResource Text.Label}" Text="{loc:Loc Diagnostics.Errors}" />
                            <TextBlock Text="{Binding ErrorCount}" FontSize="24" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ErrorBrush}" Margin="0,4,0,0" />
                        </StackPanel>
                        <Border Grid.Column="1" Width="36" Height="36" CornerRadius="8"
                                Background="{DynamicResource ErrorSoftBrush}" VerticalAlignment="Center">
                            <TextBlock Text="✕" FontWeight="Bold" FontSize="16"
                                       Foreground="{DynamicResource ErrorBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Border>
            </UniformGrid>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                <Button Content="{loc:Loc Diagnostics.Run}" Command="{Binding RunCommand}" Margin="0,0,8,0" />
                <Button Content="{loc:Loc Diagnostics.Save}" Command="{Binding SaveCommand}"
                        Style="{DynamicResource SecondaryButtonStyle}" Margin="0,0,8,0" />
                <Button Content="{loc:Loc Diagnostics.Copy}" Command="{Binding CopyCommand}"
                        Style="{DynamicResource SecondaryButtonStyle}" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Style="{DynamicResource CardStyle}" Padding="0">
            <DataGrid ItemsSource="{Binding Items}" BorderThickness="0" Background="Transparent">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="{loc:Loc Diagnostics.Severity}" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="4" Padding="8,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Severity}" Value="Error">
                                                    <Setter Property="Background" Value="{DynamicResource ErrorSoftBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                                    <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Severity}" Value="Ok">
                                                    <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding SeveritySymbol}" FontSize="11" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Severity}" Value="Error">
                                                        <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                                        <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Severity}" Value="Ok">
                                                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="{loc:Loc Diagnostics.Category}" Binding="{Binding Category}" Width="140" />
                    <DataGridTextColumn Header="{loc:Loc Diagnostics.Title}" Binding="{Binding Title}" Width="*" />
                    <DataGridTextColumn Header="{loc:Loc Diagnostics.Detail}" Binding="{Binding Detail}" Width="2*" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>