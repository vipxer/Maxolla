<UserControl x:Class="OllamaManager.App.Views.BenchmarkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:OllamaManager.App.Localization"
             xmlns:conv="clr-namespace:OllamaManager.App.Localization"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">
    <UserControl.Resources>
        <conv:LocConverter x:Key="Loc" />
        <conv:BoolToVisibilityConverter x:Key="BoolVis" />
        <conv:NullToBoolConverter x:Key="NullBool" />
    </UserControl.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="280" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Style="{DynamicResource Text.H1}" Text="{loc:Loc Benchmark.Title}" />
            <TextBlock Style="{DynamicResource Text.Caption}" Text="{loc:Loc Benchmark.Subtitle}" Margin="0,4,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Style="{DynamicResource CardStyle}" Margin="0,0,0,16" Padding="20">
            <StackPanel>
                <TextBlock Style="{DynamicResource Text.H3}" Text="{loc:Loc Benchmark.Config}" Margin="0,0,0,12" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{DynamicResource Text.Label}"
                               Text="{loc:Loc Benchmark.Model}" VerticalAlignment="Center" />
                    <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding AvailableModels}"
                              SelectedItem="{Binding SelectedModel}" Margin="0,0,8,0" Grid.ColumnSpan="2" />

                    <TextBlock Grid.Row="0" Grid.Column="3" Style="{DynamicResource Text.Label}"
                               Text="{loc:Loc Benchmark.WarmupRuns}" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <TextBox Grid.Row="0" Grid.Column="4" Text="{Binding WarmupRuns, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="0" Grid.Column="5" Style="{DynamicResource Text.Label}"
                               Text="{loc:Loc Benchmark.TestRuns}" VerticalAlignment="Center" Margin="6,0,4,0" />
                    <TextBox Grid.Row="0" Grid.Column="6" Text="{Binding NumRuns, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="0" Grid.Column="7" Style="{DynamicResource Text.Label}"
                               Text="{loc:Loc Benchmark.MaxTokens}" VerticalAlignment="Center" Margin="6,0,4,0" />
                    <Button Grid.Row="0" Grid.Column="8" Content="{loc:Loc Benchmark.Run}" Command="{Binding RunCommand}"
                            Style="{DynamicResource AccentButtonStyle}" Margin="8,0,0,0" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Style="{DynamicResource Text.Label}"
                               Text="{loc:Loc Benchmark.Prompt}" VerticalAlignment="Top" Margin="0,12,8,0" />
                    <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="8"
                             Text="{Binding Prompt, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                             Height="60" TextWrapping="Wrap" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto" />
                </Grid>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{DynamicResource CardStyle}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{DynamicResource SurfaceAltBrush}" Padding="16,12" CornerRadius="10,10,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Loc Benchmark.History}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="{loc:Loc Common.Refresh}" Command="{Binding LoadHistoryCommand}"
                                    Style="{DynamicResource GhostButtonStyle}" Margin="0,0,4,0" />
                            <Button Content="{loc:Loc Benchmark.DeleteItem}" Command="{Binding DeleteHistoryItemCommand}"
                                    Style="{DynamicResource GhostButtonStyle}" Margin="0,0,4,0" />
                            <Button Content="{loc:Loc Benchmark.DeleteAll}" Command="{Binding DeleteAllHistoryCommand}"
                                    Style="{DynamicResource GhostButtonStyle}" Margin="0,0,4,0" />
                            <Button Content="{loc:Loc Benchmark.ExportCsv}" Command="{Binding ExportCsvCommand}"
                                    Style="{DynamicResource GhostButtonStyle}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <DataGrid Grid.Row="1" ItemsSource="{Binding History}" SelectedItem="{Binding SelectedHistoryItem}"
                          BorderThickness="0" Background="Transparent">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{loc:Loc Benchmark.Timestamp}"
                                            Binding="{Binding Timestamp, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" Width="160" />
                        <DataGridTextColumn Header="{loc:Loc Benchmark.Model}" Binding="{Binding Model}" Width="*" />
                        <DataGridTextColumn Header="{loc:Loc Benchmark.AvgTps}"
                                            Binding="{Binding AverageTokensPerSecond, StringFormat='{}{0:F2}'}" Width="100" />
                        <DataGridTextColumn Header="{loc:Loc Benchmark.MinTps}"
                                            Binding="{Binding MinTokensPerSecond, StringFormat='{}{0:F2}'}" Width="100" />
                        <DataGridTextColumn Header="{loc:Loc Benchmark.MaxTps}"
                                            Binding="{Binding MaxTokensPerSecond, StringFormat='{}{0:F2}'}" Width="100" />
                        <DataGridTextColumn Header="{loc:Loc Benchmark.MedianTps}"
                                            Binding="{Binding MedianTokensPerSecond, StringFormat='{}{0:F2}'}" Width="100" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <Border Grid.Row="3" Style="{DynamicResource CardStyle}" Margin="0,16,0,0" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="📈" FontFamily="Segoe UI Emoji, Segoe UI Symbol, Segoe UI"
                                   FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="{loc:Loc Benchmark.LatestResult}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding LatestResultSummary}" Margin="12,0,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="{loc:Loc Benchmark.ExportJson}" Command="{Binding ExportJsonCommand}"
                            Style="{DynamicResource SecondaryButtonStyle}" />
                </Grid>

                <Grid Grid.Row="1" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressPercent}" Height="6" />
                    <TextBlock Grid.Column="1" Text="{Binding ProgressMessage}" VerticalAlignment="Center"
                               Margin="12,0,0,0" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" />
                </Grid>

                <Grid Grid.Row="2" Margin="0,12,0,0">
                    <lvc:CartesianChart Series="{Binding TpsSeries}" XAxes="{Binding TpsXAxes}"
                                        YAxes="{Binding TpsYAxes}" LegendPosition="Hidden" ZoomMode="X" />
                    <Border VerticalAlignment="Center" HorizontalAlignment="Center"
                            Style="{DynamicResource CardSubtleStyle}" Padding="20,14"
                            Visibility="{Binding LatestResult, Converter={StaticResource NullBool}, ConverterParameter=Invert}">
                        <StackPanel>
                            <TextBlock Text="📊" FontFamily="Segoe UI Emoji, Segoe UI Symbol, Segoe UI"
                                       FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,8" />
                            <TextBlock Text="{loc:Loc Benchmark.NoResult}" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>