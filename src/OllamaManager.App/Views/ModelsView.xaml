<UserControl x:Class="OllamaManager.App.Views.ModelsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:OllamaManager.App.Localization"
             xmlns:conv="clr-namespace:OllamaManager.App.Localization">
    <UserControl.Resources>
        <conv:LocConverter x:Key="Loc" />
        <conv:BoolToVisibilityConverter x:Key="BoolVis" />
        <conv:NullToBoolConverter x:Key="NullBool" />
        <conv:InverseBoolConverter x:Key="InverseBool" />
    </UserControl.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Style="{DynamicResource CardStyle}" Margin="0,0,0,16" Padding="16,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="240" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0" Text="{Binding PullModelName, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="{loc:Loc Tip.PullModelName}" Margin="0,0,8,0" />
                <Button Grid.Column="1" Content="{loc:Loc Models.Pull}" Command="{Binding PullModelCommand}"
                        ToolTip="{loc:Loc Tip.PullButton}" Margin="0,0,8,0" />
                <TextBox Grid.Column="2" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="{loc:Loc Tip.ModelsSearch}" Margin="0,0,8,0" />
                <Button Grid.Column="3" Content="{loc:Loc Common.Refresh}" Command="{Binding LoadModelsCommand}"
                        Style="{DynamicResource SecondaryButtonStyle}" ToolTip="{loc:Loc Tip.RefreshButton}" Margin="0,0,8,0" />
                <Button Grid.Column="4" Content="{loc:Loc Models.Action.PreloadAll}" Command="{Binding PreloadAllCommand}"
                        Style="{DynamicResource SecondaryButtonStyle}" ToolTip="{loc:Loc Tip.PreloadAll}" Margin="0,0,8,0" />
                <Button Grid.Column="5" Content="{loc:Loc Models.ReleaseAll}" Command="{Binding ReleaseAllModelsCommand}"
                        Style="{DynamicResource SecondaryButtonStyle}" ToolTip="{loc:Loc Tip.ReleaseAllModels}" />
            </Grid>
        </Border>

        <!-- Body -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="380" />
            </Grid.ColumnDefinitions>

            <Border Style="{DynamicResource CardStyle}" Padding="0">
                <DataGrid x:Name="ModelsGrid" ItemsSource="{Binding FilteredModels}" SelectedItem="{Binding SelectedModel}"
                          BorderThickness="0" Background="Transparent" Margin="0">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="#" Width="48">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ItemNumber}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextTertiaryBrush}" FontFamily="Consolas" FontSize="12" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="" Width="40">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding CategoryIcon}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               ToolTip="{Binding Category}" FontFamily="Segoe UI Emoji, Segoe UI Symbol, Segoe UI" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="{loc:Loc Models.Name}" Binding="{Binding Name}" Width="*" />
                        <DataGridTextColumn Header="{loc:Loc Models.Size}" Binding="{Binding DisplaySize}" Width="100" />
                        <DataGridTextColumn Header="{loc:Loc Models.Modified}" Binding="{Binding ModifiedAt, StringFormat='{}{0:MM-dd HH:mm}'}" Width="120" />
                        <DataGridTemplateColumn Header="{loc:Loc Models.Status}" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{DynamicResource TextTertiaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Running">
                                                            <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Loading">
                                                            <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Error">
                                                            <Setter Property="Fill" Value="{DynamicResource ErrorBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" FontSize="12" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{loc:Loc Models.Action.Start}" Command="{Binding DataContext.RunModelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                <MenuItem.Icon>
                                    <TextBlock Text="&#x25B6;" FontFamily="Segoe UI Symbol" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{loc:Loc Models.Action.Stop}" Command="{Binding DataContext.StopModelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            <MenuItem Header="{loc:Loc Models.Action.Unload}" Command="{Binding DataContext.UnloadModelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            <Separator />
                            <MenuItem Header="{loc:Loc Models.Action.Benchmark}" Command="{Binding DataContext.BenchmarkSelectedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            <MenuItem Header="{loc:Loc Models.Action.OpenModelfile}" Command="{Binding DataContext.ShowModelfileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            <Separator />
                            <MenuItem Header="{loc:Loc Models.Action.CopyName}" Command="{Binding DataContext.CopyNameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            <MenuItem Header="{loc:Loc Models.Action.Delete}" Command="{Binding DataContext.DeleteModelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                </DataGrid>
            </Border>

            <Border Grid.Column="1" Style="{DynamicResource CardStyle}" Margin="12,0,0,0" Padding="20">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <!-- Empty state -->
                        <StackPanel Visibility="{Binding SelectedModel, Converter={StaticResource NullBool}, ConverterParameter=Invert}">
                            <Border Width="56" Height="56" CornerRadius="14" Background="{DynamicResource SurfaceAltBrush}" HorizontalAlignment="Center" Margin="0,16,0,12">
                                <TextBlock Text="&#x1F50D;" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{loc:Loc Models.NoSelection}" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Text="{loc:Loc Models.NoSelectionHint}" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                        </StackPanel>

                        <!-- Selected details -->
                        <StackPanel Visibility="{Binding SelectedModel, Converter={StaticResource NullBool}}">
                            <TextBlock Style="{DynamicResource Text.H3}" Text="{loc:Loc Models.Details}" Margin="0,0,0,12" />

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBlock Text="{Binding SelectedModel.CategoryIcon}" FontSize="22" VerticalAlignment="Center" Margin="0,0,10,0"
                                           FontFamily="Segoe UI Emoji, Segoe UI Symbol, Segoe UI" />
                                <TextBlock Text="{Binding SelectedModel.Name}" FontWeight="SemiBold" FontSize="16" TextWrapping="Wrap" VerticalAlignment="Center" />
                            </StackPanel>

                            <Border Style="{DynamicResource CardSubtleStyle}" Padding="10,8" Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{DynamicResource TextTertiaryBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedModel.Status}" Value="Running">
                                                        <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedModel.Status}" Value="Loading">
                                                        <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedModel.Status}" Value="Error">
                                                        <Setter Property="Fill" Value="{DynamicResource ErrorBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="{Binding SelectedModel.Status}" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="13" />
                                </StackPanel>
                            </Border>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <Button Content="{loc:Loc Models.Run}" Command="{Binding RunModelCommand}"
                                        Style="{DynamicResource AccentButtonStyle}" ToolTip="{loc:Loc Tip.RunModel}" Margin="0,0,8,0" />
                                <Button Content="{loc:Loc Models.Stop}" Command="{Binding StopModelCommand}"
                                        Style="{DynamicResource SecondaryButtonStyle}" ToolTip="{loc:Loc Tip.StopModel}" Margin="0,0,8,0" />
                                <Button Content="{loc:Loc Models.Unload}" Command="{Binding UnloadModelCommand}"
                                        ToolTip="{loc:Loc Tip.UnloadModel}" Style="{DynamicResource DangerButtonStyle}" />
                            </StackPanel>

                            <Border Style="{DynamicResource CardSubtleStyle}" Margin="0,0,0,12"
                                    Visibility="{Binding OperationStatus, Converter={StaticResource NullBool}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#x23F3;" FontFamily="Segoe UI Emoji" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding OperationStatus}" VerticalAlignment="Center" FontSize="12" />
                                </StackPanel>
                            </Border>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Style="{DynamicResource Text.Label}" Text="{loc:Loc Models.Size}" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedModel.DisplaySize}" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Style="{DynamicResource Text.Label}" Text="{loc:Loc Models.Digest}" Margin="0,8,0,0" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedModel.Digest}" TextWrapping="Wrap"
                                           FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,0" />
                            </Grid>

                            <Button Content="{loc:Loc Models.Delete}" Command="{Binding DeleteModelCommand}"
                                    Style="{DynamicResource DangerButtonStyle}" HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Pull overlay -->
        <Border Grid.Row="1" Background="#A0000000" Visibility="{Binding IsPulling, Converter={StaticResource BoolVis}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Width="56" Height="56" CornerRadius="28" BorderThickness="4" BorderBrush="White" Background="Transparent" HorizontalAlignment="Center">
                    <Border.RenderTransform>
                        <RotateTransform x:Name="SpinnerRotate" Angle="0" CenterX="26" CenterY="26" />
                    </Border.RenderTransform>
                    <Border.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetName="SpinnerRotate" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:1.2" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Border.Triggers>
                </Border>
                <TextBlock Text="{loc:Loc Models.Pulling}" Foreground="White" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,16,0,0" />
                <TextBlock Text="{Binding PullProgress}" Foreground="#CBD2D9" Margin="0,8,0,0" HorizontalAlignment="Center" FontFamily="Consolas" FontSize="12" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
