<UserControl x:Class="OllamaManager.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:OllamaManager.App.Localization"
             xmlns:conv="clr-namespace:OllamaManager.App.Localization">
    <UserControl.Resources>
        <conv:LocConverter x:Key="Loc" />
        <conv:BoolToVisibilityConverter x:Key="BoolVis" />
        <conv:NullToBoolConverter x:Key="NullBool" />
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Page header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Style="{DynamicResource H1Style}" Text="{loc:Loc Dashboard.Title}" />
                <TextBlock Style="{DynamicResource Text.Caption}" Text="{loc:Loc Dashboard.Subtitle}" Margin="0,4,0,0" />
            </StackPanel>

            <!-- Hero metrics -->
            <UniformGrid Grid.Row="1" Rows="1" Columns="3" Margin="0,0,0,16">
                <Border Style="{DynamicResource CardStyle}" Margin="0,0,8,0" Padding="22,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{DynamicResource Text.Label}" Text="{loc:Loc Dashboard.ModelCount}" />
                            <TextBlock Text="{Binding ModelCount}" FontSize="36" FontWeight="Bold" Margin="0,8,0,0" Foreground="{DynamicResource TextBrush}" />
                        </StackPanel>
                        <Border Grid.Column="1" Width="48" Height="48" CornerRadius="12" VerticalAlignment="Top">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#3B82F6" Offset="0" />
                                    <GradientStop Color="#6366F1" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.30" Color="#3B82F6" />
                            </Border.Effect>
                            <TextBlock Text="&#x1F4E6;" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Border>
                <Border Style="{DynamicResource CardStyle}" Margin="4,0" Padding="22,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{DynamicResource Text.Label}" Text="{loc:Loc Dashboard.RunningCount}" />
                            <TextBlock Text="{Binding RunningModelCount}" FontSize="36" FontWeight="Bold" Margin="0,8,0,0" Foreground="{DynamicResource SuccessBrush}" />
                        </StackPanel>
                        <Border Grid.Column="1" Width="48" Height="48" CornerRadius="12" Background="{DynamicResource SuccessSoftBrush}" VerticalAlignment="Top">
                            <TextBlock Text="&#x25B6;" FontSize="20" Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Border>
                <Border Style="{DynamicResource CardStyle}" Margin="8,0,0,0" Padding="22,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{DynamicResource Text.Label}" Text="{loc:Loc Dashboard.DiskUsage}" />
                            <TextBlock Text="{Binding TotalDiskUsageDisplay}" FontSize="36" FontWeight="Bold" Margin="0,8,0,0" Foreground="{DynamicResource WarningBrush}" />
                        </StackPanel>
                        <Border Grid.Column="1" Width="48" Height="48" CornerRadius="12" Background="{DynamicResource WarningSoftBrush}" VerticalAlignment="Top">
                            <TextBlock Text="&#x1F4BE;" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Border>
            </UniformGrid>

            <!-- Ollama info -->
            <Border Grid.Row="2" Style="{DynamicResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource PrimarySoftBrush}" VerticalAlignment="Center">
                            <TextBlock Text="ℹ" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Grid.Column="1" Style="{DynamicResource Text.H3}" Text="{loc:Loc Dashboard.OllamaInfo}" VerticalAlignment="Center" Margin="12,0,0,0" />
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Style="{DynamicResource Text.Label}" Text="{loc:Loc Dashboard.Version}" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding OllamaVersion}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Style="{DynamicResource Text.Label}" Text="{loc:Loc Dashboard.Endpoint}" Margin="0,10,0,0" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding OllamaEndpoint}" Margin="0,10,0,0" FontFamily="Consolas" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Style="{DynamicResource Text.Label}" Text="{loc:Loc Dashboard.Executable}" Margin="0,10,0,0" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding OllamaExecutablePath}" TextWrapping="Wrap" Margin="0,10,0,0" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Style="{DynamicResource Text.Label}" Text="{loc:Loc Dashboard.ModelsDir}" Margin="0,10,0,0" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ModelsDirectory}" TextWrapping="Wrap" Margin="0,10,0,0" />

                        <TextBlock Grid.Row="4" Grid.Column="0" Style="{DynamicResource Text.Label}" Text="{loc:Loc Dashboard.Discovery}" Margin="0,10,0,0" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding DiscoveryMethod}" Margin="0,10,0,0" />

                        <TextBlock Grid.Row="5" Grid.Column="0" Style="{DynamicResource Text.Label}" Text="{loc:Loc Dashboard.Status}" Margin="0,10,0,0" />
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding StatusMessage}" Margin="0,10,0,0" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Running models -->
            <Border Grid.Row="3" Style="{DynamicResource CardStyle}">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource SuccessSoftBrush}" VerticalAlignment="Center">
                            <TextBlock Text="▶" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Grid.Column="1" Style="{DynamicResource Text.H3}" Text="{loc:Loc Dashboard.RunningCount}" VerticalAlignment="Center" Margin="12,0,0,0" />
                        <TextBlock Grid.Column="2" Style="{DynamicResource Text.Caption}" Text="{loc:Loc Dashboard.RunningHint}" VerticalAlignment="Center" Margin="12,0,0,0" />
                    </Grid>
                    <DataGrid ItemsSource="{Binding RunningModels}" MaxHeight="280">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{loc:Loc Running.Model}" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="{loc:Loc Running.Size}" Binding="{Binding DisplaySize}" Width="120" />
                            <DataGridTextColumn Header="{loc:Loc Running.VRAM}" Binding="{Binding DisplayVram}" Width="120" />
                            <DataGridTextColumn Header="{loc:Loc Running.Expires}" Binding="{Binding ExpiresAt, StringFormat='{}{0:HH:mm:ss}'}" Width="100" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Style="{DynamicResource Text.Caption}"
                               Text="{loc:Loc Dashboard.EmptyRunning}"
                               HorizontalAlignment="Center" Margin="0,24,0,12"
                               Visibility="{Binding RunningModels.Count, Converter={StaticResource BoolVis}, ConverterParameter=Invert}" />
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
