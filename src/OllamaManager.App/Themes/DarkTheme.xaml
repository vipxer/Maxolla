<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ============ COLOR TOKENS ============ -->
    <!-- Brand: vivid sky-blue that pops on dark backgrounds -->
    <Color x:Key="PrimaryColor">#3B82F6</Color>
    <Color x:Key="PrimaryHoverColor">#60A5FA</Color>
    <Color x:Key="PrimaryPressedColor">#2563EB</Color>
    <Color x:Key="PrimarySoftColor">#1E3A8A</Color>
    <Color x:Key="PrimaryGradientStartColor">#60A5FA</Color>
    <Color x:Key="PrimaryGradientEndColor">#3B82F6</Color>

    <!-- Accent: cool teal -->
    <Color x:Key="AccentColor">#06B6D4</Color>
    <Color x:Key="AccentSoftColor">#155E75</Color>

    <!-- Surfaces (deep slate-blue tones, layered) -->
    <Color x:Key="BackgroundColor">#0B1220</Color>
    <Color x:Key="BackgroundPatternColor">#0F172A</Color>
    <Color x:Key="SurfaceColor">#111827</Color>
    <Color x:Key="SurfaceAltColor">#1F2937</Color>
    <Color x:Key="SurfaceSunkenColor">#0F172A</Color>
    <Color x:Key="SidebarColor">#0F172A</Color>
    <Color x:Key="HeaderColor">#0F172A</Color>

    <!-- Borders -->
    <Color x:Key="BorderColor">#1F2937</Color>
    <Color x:Key="BorderStrongColor">#374151</Color>
    <Color x:Key="DividerColor">#1F2937</Color>

    <!-- Text -->
    <Color x:Key="TextColor">#F1F5F9</Color>
    <Color x:Key="TextSecondaryColor">#94A3B8</Color>
    <Color x:Key="TextTertiaryColor">#64748B</Color>
    <Color x:Key="TextOnPrimaryColor">#FFFFFF</Color>

    <!-- Semantic -->
    <Color x:Key="SuccessColor">#10B981</Color>
    <Color x:Key="SuccessSoftColor">#064E3B</Color>
    <Color x:Key="WarningColor">#F59E0B</Color>
    <Color x:Key="WarningSoftColor">#78350F</Color>
    <Color x:Key="ErrorColor">#EF4444</Color>
    <Color x:Key="ErrorSoftColor">#7F1D1D</Color>
    <Color x:Key="InfoColor">#38BDF8</Color>
    <Color x:Key="InfoSoftColor">#0C4A6E</Color>

    <!-- User bubble gradient (chat) -->
    <Color x:Key="UserBubbleStartColor">#3B82F6</Color>
    <Color x:Key="UserBubbleEndColor">#6366F1</Color>

    <!-- AI bubble tint -->
    <Color x:Key="AiBubbleColor">#1F2937</Color>

    <!-- Shadows -->
    <Color x:Key="ShadowColor">#000000</Color>

    <!-- ============ BRUSH TOKENS ============ -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="{StaticResource PrimaryHoverColor}" />
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="{StaticResource PrimaryPressedColor}" />
    <SolidColorBrush x:Key="PrimarySoftBrush" Color="{StaticResource PrimarySoftColor}" />

    <LinearGradientBrush x:Key="PrimaryGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource PrimaryGradientStartColor}" Offset="0" />
        <GradientStop Color="{StaticResource PrimaryGradientEndColor}" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="UserBubbleBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource UserBubbleStartColor}" Offset="0" />
        <GradientStop Color="{StaticResource UserBubbleEndColor}" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#0F172A" Offset="0" />
        <GradientStop Color="#111827" Offset="0.5" />
        <GradientStop Color="#0F172A" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}" />

    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
    <SolidColorBrush x:Key="BackgroundPatternBrush" Color="{StaticResource BackgroundPatternColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource SurfaceAltColor}" />
    <SolidColorBrush x:Key="SurfaceSunkenBrush" Color="{StaticResource SurfaceSunkenColor}" />
    <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource SidebarColor}" />
    <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="{StaticResource HeaderColor}" />

    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}" />
    <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource DividerColor}" />

    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiaryColor}" />
    <SolidColorBrush x:Key="TextOnPrimaryBrush" Color="{StaticResource TextOnPrimaryColor}" />

    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="{StaticResource SuccessSoftColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="WarningSoftBrush" Color="{StaticResource WarningSoftColor}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />
    <SolidColorBrush x:Key="ErrorSoftBrush" Color="{StaticResource ErrorSoftColor}" />
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}" />
    <SolidColorBrush x:Key="InfoSoftBrush" Color="{StaticResource InfoSoftColor}" />

    <SolidColorBrush x:Key="AiBubbleBrush" Color="{StaticResource AiBubbleColor}" />

    <!-- ============ SPACING / RADIUS / SHADOW TOKENS ============ -->
    <sys:Double x:Key="Spacing.XS">4</sys:Double>
    <sys:Double x:Key="Spacing.S">8</sys:Double>
    <sys:Double x:Key="Spacing.M">12</sys:Double>
    <sys:Double x:Key="Spacing.L">16</sys:Double>
    <sys:Double x:Key="Spacing.XL">24</sys:Double>
    <sys:Double x:Key="Spacing.XXL">32</sys:Double>

    <CornerRadius x:Key="Radius.S">4</CornerRadius>
    <CornerRadius x:Key="Radius.M">6</CornerRadius>
    <CornerRadius x:Key="Radius.L">10</CornerRadius>
    <CornerRadius x:Key="Radius.XL">14</CornerRadius>
    <CornerRadius x:Key="Radius.Pill">999</CornerRadius>

    <DropShadowEffect x:Key="Shadow.SM" BlurRadius="6" ShadowDepth="1" Opacity="0.20" Color="{StaticResource ShadowColor}" />
    <DropShadowEffect x:Key="Shadow.MD" BlurRadius="14" ShadowDepth="3" Opacity="0.30" Color="{StaticResource ShadowColor}" />
    <DropShadowEffect x:Key="Shadow.LG" BlurRadius="24" ShadowDepth="6" Opacity="0.40" Color="{StaticResource ShadowColor}" />
    <DropShadowEffect x:Key="Shadow.Glow" BlurRadius="20" ShadowDepth="0" Opacity="0.45" Color="{StaticResource PrimaryColor}" />

</ResourceDictionary>
