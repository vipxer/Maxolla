<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ============ COLOR TOKENS ============ -->
    <!-- Brand -->
    <Color x:Key="PrimaryColor">#2563EB</Color>
    <Color x:Key="PrimaryHoverColor">#1D4ED8</Color>
    <Color x:Key="PrimaryPressedColor">#1E40AF</Color>
    <Color x:Key="PrimarySoftColor">#EFF6FF</Color>

    <Color x:Key="AccentColor">#0EA5E9</Color>
    <Color x:Key="AccentSoftColor">#E0F2FE</Color>

    <!-- Surface (neutral backgrounds) -->
    <Color x:Key="BackgroundColor">#FAFBFC</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="SurfaceAltColor">#F4F6F8</Color>
    <Color x:Key="SurfaceSunkenColor">#EEF1F4</Color>
    <Color x:Key="SidebarColor">#FFFFFF</Color>

    <!-- Borders -->
    <Color x:Key="BorderColor">#E4E7EB</Color>
    <Color x:Key="BorderStrongColor">#CBD2D9</Color>
    <Color x:Key="DividerColor">#F0F2F5</Color>

    <!-- Text -->
    <Color x:Key="TextColor">#111827</Color>
    <Color x:Key="TextSecondaryColor">#6B7280</Color>
    <Color x:Key="TextTertiaryColor">#9CA3AF</Color>
    <Color x:Key="TextOnPrimaryColor">#FFFFFF</Color>

    <!-- Semantic -->
    <Color x:Key="SuccessColor">#059669</Color>
    <Color x:Key="SuccessSoftColor">#D1FAE5</Color>
    <Color x:Key="WarningColor">#D97706</Color>
    <Color x:Key="WarningSoftColor">#FEF3C7</Color>
    <Color x:Key="ErrorColor">#DC2626</Color>
    <Color x:Key="ErrorSoftColor">#FEE2E2</Color>
    <Color x:Key="InfoColor">#0284C7</Color>
    <Color x:Key="InfoSoftColor">#E0F2FE</Color>

    <!-- Shadows (alpha layers) -->
    <Color x:Key="ShadowColor">#000000</Color>

    <!-- ============ BRUSH TOKENS ============ -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="{StaticResource PrimaryHoverColor}" />
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="{StaticResource PrimaryPressedColor}" />
    <SolidColorBrush x:Key="PrimarySoftBrush" Color="{StaticResource PrimarySoftColor}" />

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}" />

    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource SurfaceAltColor}" />
    <SolidColorBrush x:Key="SurfaceSunkenBrush" Color="{StaticResource SurfaceSunkenColor}" />
    <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource SidebarColor}" />

    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}" />
    <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource DividerColor}" />

    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiaryColor}" />
    <SolidColorBrush x:Key="TextOnPrimaryBrush" Color="{StaticResource TextOnPrimaryColor}" />

    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="{StaticResource SuccessSoftColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="WarningSoftBrush" Color="{StaticResource WarningSoftColor}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />
    <SolidColorBrush x:Key="ErrorSoftBrush" Color="{StaticResource ErrorSoftColor}" />
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}" />
    <SolidColorBrush x:Key="InfoSoftBrush" Color="{StaticResource InfoSoftColor}" />

    <!-- ============ SPACING / RADIUS / SHADOW TOKENS ============ -->
    <sys:Double x:Key="Spacing.XS">4</sys:Double>
    <sys:Double x:Key="Spacing.S">8</sys:Double>
    <sys:Double x:Key="Spacing.M">12</sys:Double>
    <sys:Double x:Key="Spacing.L">16</sys:Double>
    <sys:Double x:Key="Spacing.XL">24</sys:Double>
    <sys:Double x:Key="Spacing.XXL">32</sys:Double>

    <CornerRadius x:Key="Radius.S">4</CornerRadius>
    <CornerRadius x:Key="Radius.M">6</CornerRadius>
    <CornerRadius x:Key="Radius.L">10</CornerRadius>
    <CornerRadius x:Key="Radius.XL">14</CornerRadius>
    <CornerRadius x:Key="Radius.Pill">999</CornerRadius>

    <DropShadowEffect x:Key="Shadow.SM" BlurRadius="6" ShadowDepth="1" Opacity="0.06" Color="{StaticResource ShadowColor}" />
    <DropShadowEffect x:Key="Shadow.MD" BlurRadius="14" ShadowDepth="3" Opacity="0.08" Color="{StaticResource ShadowColor}" />
    <DropShadowEffect x:Key="Shadow.LG" BlurRadius="24" ShadowDepth="6" Opacity="0.10" Color="{StaticResource ShadowColor}" />

</ResourceDictionary>
