<Window x:Class="OllamaManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:OllamaManager.App.Views"
        xmlns:vm="clr-namespace:OllamaManager.App.ViewModels"
        xmlns:loc="clr-namespace:OllamaManager.App.Localization"
        xmlns:conv="clr-namespace:OllamaManager.App.Localization"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        Title="{loc:Loc App.Title}"
        Height="820" Width="1320"
        MinHeight="680" MinWidth="1080"
        WindowStartupLocation="CenterScreen"
        FlowDirection="LeftToRight"
        Background="{DynamicResource BackgroundBrush}">
    <Window.Resources>
        <conv:LocConverter x:Key="Loc" />
        <conv:BoolToVisibilityConverter x:Key="BoolVis" />
        <conv:InverseBoolConverter x:Key="InverseBool" />
        <conv:NullToBoolConverter x:Key="NullBool" />
        <conv:CountToBoolConverter x:Key="CountBool" />

        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ModelsViewModel}">
            <views:ModelsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RunningViewModel}">
            <views:RunningView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ChatViewModel}">
            <views:ChatView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ModelfileViewModel}">
            <views:ModelfileView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BenchmarkViewModel}">
            <views:BenchmarkView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:GpuViewModel}">
            <views:GpuView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DiagnosticsViewModel}">
            <views:DiagnosticsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BackupViewModel}">
            <views:BackupView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LogsViewModel}">
            <views:LogsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>

        <!-- Tray context menu (WPF-rendered so it follows our dark theme) -->
        <ContextMenu x:Key="TrayMenu" MinWidth="240">
            <MenuItem x:Name="TrayStatusItem" Header="{loc:Loc Status.Unknown}" IsEnabled="False" />
            <Separator />
            <MenuItem Header="{loc:Loc Nav.Dashboard}" Click="OnTrayMenuNavigate" Tag="Dashboard" />
            <MenuItem Header="{loc:Loc Nav.Models}" Click="OnTrayMenuNavigate" Tag="Models" />
            <MenuItem Header="{loc:Loc Nav.Chat}" Click="OnTrayMenuNavigate" Tag="Chat" />
            <MenuItem Header="{loc:Loc Nav.Running}" Click="OnTrayMenuNavigate" Tag="Running" />
            <Separator />
            <MenuItem x:Name="TrayRunningHeader" IsEnabled="False" FontWeight="SemiBold" />
            <Separator x:Name="TrayRunningPre" />
            <MenuItem x:Name="TrayRunningEmpty" IsEnabled="False" Visibility="Collapsed" />
            <Separator x:Name="TrayRunningPost" />
            <MenuItem Header="{loc:Loc Tray.ShowMainWindow}" Click="OnTrayMenuOpen" />
            <Separator />
            <MenuItem Header="{loc:Loc Tray.Exit}" Click="OnTrayMenuExit" />
        </ContextMenu>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height="*" />
            <RowDefinition Height="34" />
        </Grid.RowDefinitions>

        <!-- ============ TOP HEADER BAR (with subtle gradient) ============ -->
        <Border Grid.Row="0" Background="{DynamicResource HeaderBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Brand: gradient square with subtle outer glow -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="36" Height="36" CornerRadius="10" Margin="0,0,14,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#60A5FA" Offset="0" />
                                <GradientStop Color="#6366F1" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="0" Opacity="0.45" Color="#3B82F6" />
                        </Border.Effect>
                        <TextBlock Text="M" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{loc:Loc App.Title}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                        <TextBlock Text="Ollama 管理工具" FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,1,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- Page title (active nav item) -->
                <TextBlock Grid.Column="1" Text="{Binding SelectedNavItem.Label}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold" />

                <!-- Ollama status pill with pulse on the dot -->
                <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" CornerRadius="16" Padding="14,7"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" VerticalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="8" ShadowDepth="0" Opacity="0.18" Color="Black" />
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="10" Height="10" Margin="0,0,10,0" VerticalAlignment="Center">
                            <Ellipse x:Name="StatusGlow" Width="10" Height="10" Opacity="0">
                                <Ellipse.Fill>
                                    <SolidColorBrush Color="{DynamicResource SuccessColor}" />
                                </Ellipse.Fill>
                                <Ellipse.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.45" To="0" Duration="0:0:1.6" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Ellipse.Triggers>
                            </Ellipse>
                            <Ellipse Width="10" Height="10">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding OllamaStatusKind}" Value="NotRunning">
                                                <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding OllamaStatusKind}" Value="NotInstalled">
                                                <Setter Property="Fill" Value="{DynamicResource ErrorBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding OllamaStatusKind}" Value="Unknown">
                                                <Setter Property="Fill" Value="{DynamicResource TextTertiaryBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                        </Grid>
                        <TextBlock Text="Ollama" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,5,0" />
                        <TextBlock Text="{Binding OllamaStatusText}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ============ MAIN BODY: NAV + CONTENT ============ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Side Nav (non-scrolling — fits all 11 items + exit) -->
            <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled" Padding="0,10,0,0">
                        <ItemsControl ItemsSource="{Binding NavItems}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton Style="{DynamicResource NavButton}" GroupName="Nav"
                                                 IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                 Checked="OnNavItemChecked">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="28" Height="28" CornerRadius="8" Background="{DynamicResource SurfaceAltBrush}" Margin="0,0,10,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Glyph}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </Border>
                                            <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </RadioButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Button Grid.Row="1" Margin="10,8,10,16" Click="OnNavExitClick"
                            Style="{DynamicResource DangerSubtleButton}"
                            HorizontalContentAlignment="Stretch" ToolTip="{loc:Loc Nav.Exit}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="28" Height="28" CornerRadius="8" Background="{DynamicResource ErrorSoftBrush}" VerticalAlignment="Center" Margin="0,0,10,0">
                                <Path Width="14" Height="14" Stretch="Uniform"
                                      Stroke="{DynamicResource ErrorBrush}" StrokeThickness="1.8"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Fill="Transparent"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Data="M 11 4 H 5 A 2 2 0 0 0 3 6 V 18 A 2 2 0 0 0 5 20 H 11 M 8 12 H 21 M 16 7 L 21 12 L 16 17" />
                            </Border>
                            <TextBlock Grid.Column="1" Text="{loc:Loc Nav.Exit}" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource ErrorBrush}" FontSize="13" />
                        </Grid>
                    </Button>
                </Grid>
            </Border>

            <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" Margin="0">
                <ContentControl.RenderTransform>
                    <TranslateTransform x:Name="PageSlide" X="0" />
                </ContentControl.RenderTransform>
            </ContentControl>
        </Grid>

        <!-- ============ STATUS BAR ============ -->
        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="24,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="6" Height="6" Margin="0,0,8,0" Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0" FontSize="11">
                    <Run Text="{loc:Loc About.Developer}" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <Run Text="vipxer" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                </TextBlock>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{loc:Loc StatusBar.LastUpdated}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding LastUpdated, StringFormat='{}{0:HH:mm:ss}'}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" FontFamily="Consolas" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ TRAY ============ -->
        <tb:TaskbarIcon x:Name="TrayIcon"
                        ToolTipText="{loc:Loc App.Title}"
                        TrayMouseDoubleClick="OnTrayIconDoubleClick"
                        TrayRightMouseUp="OnTrayRightClick" />
    </Grid>
</Window>
