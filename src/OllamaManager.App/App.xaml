<Application x:Class="OllamaManager.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tb="http://www.hardcodet.net/taskbar"
             xmlns:loc="clr-namespace:OllamaManager.App.Localization"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Default: polished dark theme; light theme re-binds tokens via the same keys if user switches. -->
                <ResourceDictionary Source="Themes/DarkTheme.xaml" />
                <ResourceDictionary Source="Themes/CommonStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <loc:NullToBoolConverter x:Key="NullBool" />
            <loc:BoolToVisibilityConverter x:Key="BoolVis" />
            <loc:InverseBoolConverter x:Key="InverseBool" />
            <loc:CountToBoolConverter x:Key="CountBool" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
